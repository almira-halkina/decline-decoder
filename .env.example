# Copy to .env and fill in. TEST MODE KEYS ONLY — the app refuses to start with live keys.

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:8000/webhooks/stripe` or the Dashboard endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# https://platform.claude.com/settings/keys — optional; without it /explain returns the
# deterministic fallback response (flagged "llm_unavailable").
ANTHROPIC_API_KEY=
EXPLAINER_MODEL=claude-opus-5-5
EXPLAINER_EFFORT=low

DATABASE_PATH=decline_decoder.sqlite3
FRONTEND_URL=http://localhost:5173
