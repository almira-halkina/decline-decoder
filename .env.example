# Copy to .env and fill in. TEST MODE KEYS ONLY — the app refuses to start with live keys.

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:8000/webhooks/stripe` or the Dashboard endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# rules  = keyword rules over Stripe's docs text, no LLM, no API key needed (default)
# claude = Claude writes the explanations; needs ANTHROPIC_API_KEY
EXPLAINER_ENGINE=rules
# https://platform.claude.com/settings/keys — only needed when EXPLAINER_ENGINE=claude
ANTHROPIC_API_KEY=
EXPLAINER_MODEL=claude-opus-5-5
EXPLAINER_EFFORT=low

DATABASE_PATH=decline_decoder.sqlite3
FRONTEND_URL=http://localhost:5173
